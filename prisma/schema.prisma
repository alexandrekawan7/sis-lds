// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id              Int             @id @default(autoincrement())
  name            String          @default("Administrador")       
  phone           String?
  photo           Bytes?
  photoMimeType   String?
  email           String          @unique
  password        String
  roleId          Int
  role            Role            @relation(fields: [roleId], references: [id])
  departmentId    Int
  department      Department      @relation(fields: [departmentId], references: [id])
  documents       Document[]      @relation("UserDocuments")
  printRequests   PrintRequest[]  @relation("UserPrintRequests")
  approvedRequests PrintRequest[] @relation("ApprovedBy")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[]
}

model Document {
  id              String          @id @default(uuid())
  filename        String
  mimeType        String          // "application/pdf", "image/jpeg", "image/png"
  fileSize        Int             // tamanho em bytes
  data            Bytes           // conteúdo binário do arquivo
  metadata        Json            // { pages?: number, width?: number, height?: number, dpi?: number }
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     Int
  createdBy       User            @relation("UserDocuments", fields: [createdById], references: [id], onDelete: Cascade)
  printRequests   PrintRequest[]  @relation("DocumentRequests")
}

model PrintRequest {
  id              String          @id @default(uuid())
  documentId      String
  document        Document        @relation("DocumentRequests", fields: [documentId], references: [id], onDelete: Cascade)
  requestedById   Int
  requestedBy     User            @relation("UserPrintRequests", fields: [requestedById], references: [id], onDelete: Cascade)
  status          String          @default("PENDING")  // "PENDING", "APPROVED", "REJECTED", "PRINTED", "FAILED"
  copies          Int             @default(1)
  notes           String?
  approvedById    Int?
  approvedBy      User?           @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalNotes   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}
