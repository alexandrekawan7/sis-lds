// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[]
}

model Department {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  id            Int           @id @default(autoincrement())
  name          String        @default("Administrador")
  phone         String?
  photo         Bytes?
  photoMimeType String?
  email         String        @unique
  password      String
  roleId        Int
  role          Role          @relation(fields: [roleId], references: [id])
  departmentId  Int
  department    Department    @relation(fields: [departmentId], references: [id])
  documents     Document[]    @relation("UserDocuments")
  solicitacoes  Solicitacao[]
  notifications Notification[]
}

enum SolicitacaoStatus {
  AGUARDANDO
  APROVADA
  REJEITADA
  IMPRIMINDO
  IMPRESSA
  CANCELADA
}

model Solicitacao {
  id              Int               @id @default(autoincrement())
  // Etapa 1 - Material
  tipoPapel       String
  intuito         String
  copias          Int
  // Etapa 2 - Configuracoes da impressao
  tamanho         String
  orientacao      String
  modelo          String
  cor             String
  acabamento      String
  // Etapa 3 - Anexo e retirada
  documento       String?
  documentId      String?
  document        Document?         @relation("DocumentSolicitacao", fields: [documentId], references: [id], onDelete: SetNull)
  dataRetirada    String
  horarioRetirada String
  status          SolicitacaoStatus @default(AGUARDANDO)
  solicitanteId   Int
  solicitante     User              @relation(fields: [solicitanteId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[]
}

model Document {
  id           String        @id @default(uuid())
  filename     String
  mimeType     String // "application/pdf", "image/jpeg", "image/png"
  fileSize     Int // tamanho em bytes
  data         Bytes // conteúdo binário do arquivo
  metadata     Json // { pages?: number, width?: number, height?: number, dpi?: number }
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  createdById  Int
  createdBy    User          @relation("UserDocuments", fields: [createdById], references: [id], onDelete: Cascade)
  solicitacoes Solicitacao[] @relation("DocumentSolicitacao")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
